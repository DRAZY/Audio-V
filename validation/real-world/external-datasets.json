{
  "$schema": "./schemas/external-datasets.schema.json",
  "schemaVersion": 1,
  "registryVersion": "1.0.0",
  "selectionPolicy": {
    "publicReferenceTarget": 50,
    "developmentPercent": 60,
    "calibrationPercent": 20,
    "testPercent": 20,
    "neverBundleAudioWithApplication": true,
    "requireSourceLevelPartitioning": true
  },
  "datasets": [
    {
      "id": "slakh2100",
      "displayName": "Slakh2100 Redux",
      "priority": 1,
      "role": "controlled-source",
      "version": "redux-2021",
      "status": "ready",
      "license": {
        "identifier": "CC-BY-4.0",
        "name": "Creative Commons Attribution 4.0 International",
        "url": "https://creativecommons.org/licenses/by/4.0/",
        "redistributableInCorpus": true,
        "commercialUsePermitted": true,
        "notes": "Dataset audio is CC BY 4.0. Audio-V records attribution and never bundles corpus audio with the desktop application."
      },
      "official": {
        "homepage": "https://www.slakh.com/",
        "download": "https://zenodo.org/records/4599666",
        "archiveUrl": "https://zenodo.org/api/records/4599666/files/slakh2100_flac_redux.tar.gz/content",
        "archiveBytes": 104322767708,
        "archiveChecksum": "md5:f4b71b6c45ac9b506f59788456b3f0c4",
        "access": "direct"
      },
      "audio": {
        "lossless": true,
        "formats": ["flac"],
        "sampleRates": [44100],
        "bitDepths": [16],
        "notes": "Synthesized multitrack mixtures. Use mix.flac as an independent controlled source and retain the Track ID."
      },
      "import": {
        "adapter": "slakh2100",
        "defaultLimit": 30,
        "include": ["**/Track*/mix.flac"],
        "sourceIdentity": "Track directory"
      },
      "recommendedUse": [
        "Controlled lossy-to-lossless transformations",
        "Controlled sample-rate and bit-depth transformations",
        "Public reproducible baseline"
      ],
      "limitations": [
        "Synthesized material is not representative of every microphone, acoustic space, recording era, or mastering process.",
        "Known duplicate MIDI sources must stay in one partition; Slakh Redux is preferred because it removes duplicate MIDI entries."
      ]
    },
    {
      "id": "musan",
      "displayName": "MUSAN",
      "priority": 2,
      "role": "edge-control",
      "version": "SLR17",
      "status": "ready",
      "license": {
        "identifier": "CC-BY-4.0",
        "name": "Creative Commons Attribution 4.0 International",
        "url": "https://creativecommons.org/licenses/by/4.0/",
        "redistributableInCorpus": true,
        "commercialUsePermitted": true,
        "notes": "OpenSLR identifies SLR17 as CC BY 4.0. The importer additionally hashes the nearest component LICENSE file and attaches that evidence to every imported reference."
      },
      "official": {
        "homepage": "https://www.openslr.org/17/",
        "download": "https://www.openslr.org/17/",
        "archiveUrl": "https://www.openslr.org/resources/17/musan.tar.gz",
        "archiveBytes": 11086114085,
        "access": "direct"
      },
      "audio": {
        "lossless": true,
        "formats": ["wav"],
        "sampleRates": [],
        "bitDepths": [],
        "notes": "Music, speech, and noise recordings with heterogeneous source characteristics."
      },
      "import": {
        "adapter": "musan",
        "defaultLimit": 20,
        "include": ["music/**/*.wav", "speech/**/*.wav", "noise/**/*.wav"],
        "sourceIdentity": "Relative recording path"
      },
      "recommendedUse": [
        "False-positive and abstention testing",
        "Speech, noise, and narrow-band controls",
        "Public edge-condition population"
      ],
      "limitations": [
        "MUSAN is an edge-condition collection, not proof that a recording is a native studio master.",
        "Source characteristics vary and must be reported by category."
      ]
    },
