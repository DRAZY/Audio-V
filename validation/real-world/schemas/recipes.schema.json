{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DRAZY/Audio-V/validation/real-world/schemas/recipes.schema.json",
  "title": "Audio-V validation recipes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recipeSetVersion", "recipes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "recipeSetVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "truthClass", "acceptedClassifications", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "truthClass": { "enum": ["native-control", "lossy-to-lossless", "multi-generation-lossy", "upsample", "intentional-lowpass", "bit-depth-conversion", "clipping", "channel-transformation", "deterministic-corruption"] },
          "acceptedClassifications": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "enum": ["no-strong-spectral-anomaly", "bandwidth-limited", "possible-lossy-transcode", "possible-upsample", "inconclusive", "not-assessed"]
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "analysisStates": {
                "type": "array",
                "items": { "enum": ["completed", "failed", "error"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "stereoAssessments": {
                "type": "array",
                "items": { "enum": ["mono", "dual-mono", "near-mono", "stereo-content", "inconclusive"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "minimumClippedSamples": { "type": "integer", "minimum": 1 }
            }
          },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
