{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DRAZY/Audio-V/validation/real-world/schemas/external-datasets.schema.json",
  "title": "Audio-V external validation dataset registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryVersion", "selectionPolicy", "datasets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "registryVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicReferenceTarget", "developmentPercent", "calibrationPercent", "testPercent", "neverBundleAudioWithApplication", "requireSourceLevelPartitioning"],
      "properties": {
        "publicReferenceTarget": { "type": "integer", "minimum": 1 },
        "developmentPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "calibrationPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "testPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "neverBundleAudioWithApplication": { "const": true },
        "requireSourceLevelPartitioning": { "const": true }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "priority", "role", "version", "status", "license", "official", "audio", "import", "recommendedUse", "limitations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "displayName": { "type": "string", "minLength": 2 },
        "priority": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["controlled-source", "edge-control", "real-recording-challenge", "standardized-test", "academic-challenge"] },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ready", "ready-research-only", "manual-terms-review", "manual-approval"] },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "name", "url", "redistributableInCorpus", "commercialUsePermitted", "notes"],
          "properties": {
            "identifier": { "type": "string", "minLength": 2 },
            "name": { "type": "string", "minLength": 3 },
            "url": { "type": "string", "format": "uri" },
            "redistributableInCorpus": { "type": "boolean" },
            "commercialUsePermitted": { "type": "boolean" },
            "notes": { "type": "string", "minLength": 10 }
          }
        },
        "official": {
          "type": "object",
          "additionalProperties": false,
          "required": ["homepage", "download", "access"],
          "properties": {
            "homepage": { "type": "string", "format": "uri" },
            "download": { "type": "string", "format": "uri" },
            "archiveUrl": { "type": "string", "format": "uri" },
            "archiveBytes": { "type": "integer", "minimum": 1 },
            "archiveChecksum": { "type": "string", "pattern": "^(md5|sha256):[a-f0-9]+$" },
            "access": { "enum": ["direct", "manual", "approval"] }
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lossless", "formats", "sampleRates", "bitDepths", "notes"],
          "properties": {
            "lossless": { "type": "boolean" },
            "formats": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
            "sampleRates": { "type": "array", "items": { "type": "integer", "minimum": 8000 }, "uniqueItems": true },
            "bitDepths": { "type": "array", "items": { "type": "integer", "minimum": 8 }, "uniqueItems": true },
            "notes": { "type": "string", "minLength": 10 }
          }
        },
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "defaultLimit", "include", "sourceIdentity"],
          "properties": {
            "adapter": { "enum": ["slakh2100", "musan", "maestro", "ebu-sqam", "musdb18-hq"] },
            "defaultLimit": { "type": "integer", "minimum": 1 },
            "include": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "sourceIdentity": { "type": "string", "minLength": 3 }
          }
        },
        "recommendedUse": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
